{
  "name": "streamhub-qa-assessment",
  "version": "1.0.0",
  "private": true,
  "description": "Loan catalog API for the Streamhub QA automation assessment",
  "scripts": {
    "dev": "tsx watch src/api/server.ts",
    "start": "tsx src/api/server.ts",
    "generate:repayments": "tsx scripts/generate-repayments.ts",
    "typecheck": "tsc --noEmit",
    "test:api": "cucumber-js --profile default --profile api",
    "test:ui": "cucumber-js --profile default --profile ui",
    "test:self-healing": "cucumber-js --profile default --profile self-healing",
    "suggest:locators": "tsx scripts/suggest-locators.ts",
    "sql": "tsx scripts/run-sql.ts",
    "results:capture": "tsx scripts/capture-results.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "dotenv": "^18.0.5",
    "express": "^4.22.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^13.3.0",
    "@playwright/test": "^1.63.0",
    "@types/express": "^4.17.25",
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
